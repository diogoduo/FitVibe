# Copie para .env.local (que fica fora do git) e preencha.

# Chave pública do Supabase local: `npm run db:status` → "Publishable key".
EXPO_PUBLIC_SUPABASE_KEY=

# Opcional. Sem ela, em desenvolvimento o app usa o IP do PC que serve o Metro
# (porta 54321). Preencha para usar o Supabase na nuvem ou um túnel HTTPS.
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.trycloudflare.com
