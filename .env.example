# Copie para .env.local (que fica fora do git) e preencha. Só a chave publishable:
# a secreta (service_role) nunca entra no app.

# Supabase na nuvem: Project Settings → API Keys (URL do projeto e "Publishable key").
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Supabase local (Docker): apague a URL acima. Sem ela, em desenvolvimento o app usa o IP do PC
# que serve o Metro (porta 54321). A chave local aparece em `npm run db:status`.
